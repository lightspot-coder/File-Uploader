<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/styles.css">
    <title><%=title%></title>
</head>
<body>
    <h1>File uploader</h1>
    <%if(locals.currentUser){%>
        <h2>Current folder : <%=currentFolder.name%></h2>
        <%if(locals.subFolders){%>
        <p><b>subfolders : </b></p>    
        <ul class="folder-list">
        <%locals.subFolders.map(folder => {%>
            <li class="folder">
            <a href="/user/<%=currentUser.userName%>/?parentFolderId=<%=folder.id%>"><%=folder.name%></a>
            </li>
        <%})}%>
        </ul>
        <%if(locals.files){%>
        <p><b>files : </b></p>
        <ul class="files-list">
        <%locals.files.map(file => {%>
            <li class="file">
            <a href="/user/<%=currentUser.userName%>/file-info?fileId=<%=file.id%>"><%=file.originalName%></a>
            </li>
        <%})}%>
        </ul>
        <div class="folder_options_div">
        <a href="/user/<%=currentUser.userName%>/create-folder?parentFolderId=<%=currentFolder.id%>">Create a folder</a>
        <a href="/user/<%=currentUser.userName%>/upload-file?folderId=<%=currentFolder.id%>">Upload a file</a>
        <%if(currentFolder.name != "root"){%>
                <a href="/user/<%=currentUser.userName%>/update-folder?folderId=<%=currentFolder.id%>">Change folder's name</a>    
        <a href="/user/<%=currentUser.userName%>/delete-folder?folderId=<%=currentFolder.id%>">Delete this folder</a>
        <br>
        <br>
        <a href="/user/<%=currentUser.userName%>/?parentFolderId=<%=currentFolder.parentFolderId%>">Back</a>
        <%}%>
        </div>
        
    <%}else{%>
        <h2>You must log in to see the content of a file</h2>
    <%}%>
   
    <a href="/">Back home</a>
</body>
</html>